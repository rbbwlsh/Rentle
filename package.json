{
  "name": "rentle",
  "version": "1.0.0",
  "description": "Rentle — guess-the-rent game powered by any Rightmove listing you paste in. Create a challenge, share the link, see who guesses closest.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -n server,client -c blue,magenta \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "node --watch server/index.js",
    "dev:client": "npm --prefix client run dev",
    "build": "npm --prefix client install && npm --prefix client run build",
    "start": "NODE_ENV=production node server/index.js",
    "test": "node --test test/*.test.mjs",
    "postinstall": "npm --prefix client install"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "express": "^4.19.2",
    "pg": "^8.12.0"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
