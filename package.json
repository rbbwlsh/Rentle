{
  "name": "rentle",
  "version": "2.0.0",
  "description": "Rentle — the daily guess-the-rent game on real UK listings. A pre-scraped corpus, a client-side game engine, one Cloudflare Worker.",
  "private": true,
  "type": "module",
  "scripts": {
    "seed": "node tools/seed.js",
    "seed:buy": "node tools/seed.js --mode buy",
    "images": "node tools/images.js",
    "corpus": "node tools/build-corpus.js",
    "dev": "npm run corpus && npm --prefix client run dev",
    "build": "npm run corpus && npm --prefix client run build && node tools/prerender.js",
    "preview": "npm --prefix client run preview",
    "preview:worker": "npm run build && wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "test": "node --test test/*.test.mjs",
    "db:migrate": "node tools/migrate.js",
    "db:seed": "node tools/seed-db.js",
    "postinstall": "npm --prefix client install"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "sharp": "^0.33.4",
    "wrangler": "^4.131.1"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0"
  }
}
