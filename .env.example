# Copy to .env (gitignored) and fill in. Nothing here is read by the app —
# these feed the deploy/upload commands run from a machine, never the site.

# Production database (Neon Postgres). A Worker secret, not in git:
#   wrangler secret put NEON_DATABASE_URL
# For `wrangler dev`, put the same line in .dev.vars (gitignored).
NEON_DATABASE_URL=

# Cloudflare API token ("Edit Cloudflare Workers" template): lets wrangler
# deploy from here. The same token goes into GitHub Actions as a repo secret.
CLOUDFLARE_API_TOKEN=

# R2 API token (Object Read & Write on the photo bucket), for rclone.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Build-time overrides for tools/config/site.json (optional):
#   SITE_URL        the deployed origin, for absolute og: tags
#   IMAGE_BASE_URL  where photos are served from, e.g. https://img.example.com
